# Banco de dados (Postgres local via docker-compose)
DATABASE_URL=postgresql+psycopg://dayup:dayup@localhost:5432/dayup

# Redis (sessões + rate limiting)
REDIS_URL=redis://localhost:6379/0

# Sessões (httpOnly cookie, opaco — o estado vive só no Redis)
SESSION_COOKIE_NAME=dayup_session
SESSION_MAX_AGE_SECONDS=2592000  # 30 dias
SESSION_COOKIE_SECURE=false      # true em produção (HTTPS)

# CSRF
CSRF_COOKIE_NAME=dayup_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# CORS — origem do frontend em dev
FRONTEND_ORIGIN=http://localhost:5173

# Ambiente
ENV=development
